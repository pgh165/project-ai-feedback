# 복사해서 쓰기:  copy .env.example .env   (키가 없어도 동작한다. 전체 설정은 config.py 참고)
SECRET_KEY=change-me

# ── 글 다듬기 LLM: Claude → Ollama → ComfyUI Gemma → 템플릿 순으로 쓴다 ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=
LLM_COMFY_ENABLED=true

# ── 분류·임베딩 모델 (로컬 CPU, 처음 실행 때 자동 다운로드) ──
CLASSIFIER_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=paraphrase-multilingual-mpnet-base-v2
EMBEDDING_FALLBACK_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# 분류 임계값 (EmbeddingClassifier는 factory에서 ×0.75 / ×0.70)
SPECIFICITY_THRESHOLD=0.45
VALIDITY_THRESHOLD=0.40
# 군집화 기본 거리 (카테고리별로 덮어씀)
CLUSTERING_DISTANCE_THRESHOLD=0.40
# 우선순위 P = α·빈도 + β·품질 + γ·심각도 + δ·긴급도 + ε·타당성
PRIORITY_ALPHA=0.35
PRIORITY_BETA=0.25
PRIORITY_GAMMA=0.20
PRIORITY_DELTA=0.12
PRIORITY_EPSILON=0.08
MANUAL_TIME_PER_FEEDBACK_MINUTES=3

# ── YouTube ──
# 댓글 수집: true=시뮬레이션 댓글, false=YouTube Data API (YOUTUBE_API_KEY 필요)
SIMULATION_MODE=true
YOUTUBE_API_KEY=
# 업로드·자막: Google Cloud OAuth 클라이언트(웹 애플리케이션) JSON 경로.
# YouTube Data API v3를 켜고, 리디렉션 URI에 http://127.0.0.1:5000/youtube/callback 등록
YOUTUBE_CLIENT_SECRETS=
# 공개 범위 기본값: private / unlisted / public (화면에서 바꿀 수 있음)
YOUTUBE_PRIVACY=private

# ── 영상 생성: comfyui(로컬 ComfyUI + LTX-2.5) / local(diffusers, requirements-video.txt) / mock ──
VIDEO_GENERATOR_ADAPTER=comfyui
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_T2V=ltx25_t2v
COMFYUI_WORKFLOW_I2V=ltx25_i2v
LTX_MODEL_VARIANT=ltx25-gguf-q4km
# 첫 프레임을 Z-Image Turbo로 먼저 만든 뒤 I2V로 움직인다 (대상 품질이 좋아짐)
COMFYUI_IMAGE_FIRST=true
COMFYUI_WORKFLOW_T2I=zimage_t2i
# '이 순간을 끝으로 다시 만들기' (첫·마지막 프레임 고정)
COMFYUI_WORKFLOW_FLF=ltx25_flf2v
# 이미지 확인 → 컷 확인 → 사람이 눌러야 러프컷 (단계별 확인 생성)
COMFYUI_STAGED_REVIEW=true
# 장면 사이에 모델을 내려 VRAM을 비운다 (이미지·영상·음악 모델을 번갈아 쓰므로 권장)
COMFYUI_FREE_BETWEEN_SHOTS=true
COMFYUI_SHOT_TIMEOUT_SEC=900
# Gemma 프롬프트 강화 (TextGenerateLTX2Prompt). 묘사가 풍부해지지만 재현성은 낮아짐
COMFYUI_PROMPT_ENHANCE=false
# true면 작은 해상도·프레임으로 빠르게 시험
COMFYUI_TEST_MODE=false

# 장면 기본값 (프로젝트의 화면 비율에 맞게 가로·세로로 배치)
STORYBOARD_SHOT_SECONDS=5
STORYBOARD_WIDTH=576
STORYBOARD_HEIGHT=960
STORYBOARD_FPS=24
# 의견으로 장면을 늘릴 때 최대 길이(초)
SHOT_MAX_SECONDS=8
PARTIAL_REGEN_ENABLED=true
REQUIRE_VIDEO_APPROVAL=true

# 러프컷: ffmpeg 경로 (비우면 PATH → imageio-ffmpeg 순으로 찾음), AI 컷 앞뒤 잘라 내기(초)
FFMPEG_PATH=
CLIP_TRIM_HEAD_SEC=0.15
CLIP_TRIM_TAIL_SEC=0.1

# local 어댑터(diffusers)용
LOCAL_VIDEO_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
LOCAL_VIDEO_WIDTH=480
LOCAL_VIDEO_HEIGHT=832
LOCAL_VIDEO_FRAMES=81
LOCAL_VIDEO_FPS=16
LOCAL_VIDEO_STEPS=30
LOCAL_VIDEO_GUIDANCE=5.0
LOCAL_VIDEO_MAX_SHOTS=8

# 상용 API (품질 부족 장면만, 사람이 비용을 확인하고 누를 때만). 키가 없으면 버튼이 비활성화된다
COMMERCIAL_VIDEO_ADAPTER=runway
RUNWAY_API_KEY=
COMMERCIAL_COST_PER_SEC_USD=0.12
COMMERCIAL_BUDGET_USD=30

# ── 한국어 ↔ 영어 (ComfyUI Gemma) ──
# 영어 장면 묘사를 화면에 한국어 번역과 함께 표시
TRANSLATE_ENABLED=true
TRANSLATE_COMFY_MODEL=gemma4_e2b_it_int8_convrot.safetensors
TRANSLATE_COMFY_CLIP_TYPE=ltxv
# ── 장면 다듬기·AI로 채우기용 큰 모델 (선택, llama-server) ──
# 비우면 Gemma4 e2b로. SERVER·MODEL을 주면 필요할 때 켜고 다 쓰면 끈다
REFINE_LLM_URL=
REFINE_LLM_LABEL=gemma4-26b
# 예: C:/Users/<사용자>/AppData/Local/Programs/Ollama/lib/ollama/llama-server.exe
REFINE_LLAMA_SERVER=
# 예: C:/Users/<사용자>/.ollama/models/blobs/sha256-...  (Gemma4 26B A4B gguf)
REFINE_LLAMA_MODEL=
REFINE_LLAMA_ARGS=-ngl 99 --n-cpu-moe 12 -c 4096 --jinja

# 한국어 입력 → 영어, AI로 채우기 (비우면 위 번역 모델)
KO_EN_COMFY_MODEL=

# ── 내레이션 (TTS) ──
# edge(Microsoft 신경망 음성, 계정 불필요·인터넷 필요) / supertonic(로컬 CPU) / qwen / windows / none
# edge·supertonic은 venv_tts2에서 돈다:  py -3.11 -m venv venv_tts2; .\venv_tts2\Scripts\pip install edge-tts supertonic
VOICE_ADAPTER=edge
VOICE_FALLBACK=supertonic
EDGE_TTS_VOICE=ko-KR-SunHiNeural
SUPERTONIC_VOICE=F1
NARRATION_VOLUME=1.0
NARRATION_BG_VOLUME=0.35
# 장면보다 긴 문장을 이만큼까지 빠르게 읽는다 / 장면 시작 후 말 시작 지연(초)
NARRATION_MAX_SPEEDUP=1.4
NARRATION_LEAD_SEC=0.2

# ── 배경음악 (ComfyUI + MiniMax Music 3) ──
# 곡을 정하지 않은 버전은 러프컷 때 곡 설명을 제안받아 만든다
BGM_AUTO=true
# 곡을 이 길이(초) 이상으로 만들어 소리 크기가 고른 구간을 골라 쓴다
MUSIC_MIN_SECONDS=60
MUSIC_DIT=minimax_music3_dit_fp16.safetensors
MUSIC_TEXT_ENCODER=minimax_music3_text_encoder_pruned_bf16.safetensors
MUSIC_VAE=minimax_music3_dav.safetensors

# ── 기타 ──
# 개발용 점검 페이지 /dev/pipeline-test
DEV_TEST_PAGE=true
# 시연용 데모 재생에서 장면마다 '만드는 중'을 보여 주는 시간(초)
DEMO_REPLAY_SEC_PER_SHOT=1.5
